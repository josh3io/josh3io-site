<%- include("partials/header.ejs") %>

<div class="container">
 <div class="container row">
   <h1 class="col"> Update/Delete Quotes </h1>

   <div class="col text-end" >
     <a class="btn btn-md btn-outline-primary" href="/quote/new">Add Quote</a>
   </div>
 </div>

 <div class="list-group">
 <% for (i=0; i < quotes.length; i++) { %>

   <div class="striped list-group-item d-flex justify-content-between align-items-center">
     <span class="me-3 text-truncate" style="max-width: 70%;"><%=quotes[i].quote%></span>
     <span class="text-nowrap">
       <a class="btn btn-sm btn-outline-primary me-1" href="/quote/edit?quoteId=<%=quotes[i].quoteId%>">UPDATE</a>
       <a class="btn btn-sm btn-outline-danger" href="/quote/delete?quoteId=<%=quotes[i].quoteId%>">DELETE</a>
     </span>
   </div>

 <% } %>
 </div>
</div>

<%- include("partials/footer.ejs") %>
</body>
</html>
