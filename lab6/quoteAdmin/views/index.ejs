<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1">
 <title>CRUD Operations</title>
 <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
 <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

 <div class="container py-5">
   <div class="row justify-content-center">
     <div class="col-md-6">
       <div class="card shadow-sm p-4 text-center">
         <h1 class="mb-4"> Famous Quotes - Admin Section </h1>

         <div class="d-grid gap-3">
           <form action="/author/new">
             <button class="btn btn-primary w-100">Add Authors</button>
           </form>

           <form action="/quote/new">
             <button class="btn btn-primary w-100">Add Quotes</button>
           </form>

           <form action="/authors">
             <button class="btn btn-outline-secondary w-100">List Authors</button>
           </form>

           <form action="/quotes">
             <button class="btn btn-outline-secondary w-100">List Quotes</button>
           </form>
         </div>
       </div>
     </div>
   </div>
 </div>

 </body>
</html>


