<%- include("partials/header.ejs") %>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-sm p-4">

<h1 class="mb-4">Edit an Author</h1>

    <form method="POST" action="/author/edit">
      <input type="hidden" name="authorId" value="<%= authorId %>">
      <div class="mb-3">
        <label class="form-label">First Name:</label>
        <input class="form-control" type="text" name="fName" value="<%= firstName %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Last Name:</label>
        <input class="form-control" type="text" name="lName" value="<%= lastName %>">
      </div>
      <div class="mb-3 container row">
        <div class="col">
          <label class="form-label">Date of Birth:</label>
          <input class="form-control" type="date" name="birthDate" value="<%= new Date(dob).toISOString().split('T')[0] %>">
        </div>
        <div class="col">
          <label class="form-label">Date of Death:</label>
          <input class="form-control" type="date" name="deathDate" value="<%= new Date(dod).toISOString().split('T')[0]%>">
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label d-block">Sex:</label>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="radio" name="sex" value="M" <%= sex == 'M' ? 'checked' : '' %> ><label class="form-check-label">Male</label>
        </div>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="radio" name="sex" value="F" <%= sex == 'F' ? 'checked' : '' %> ><label class="form-check-label">Female</label>
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Profession:</label>
        <input class="form-control" type="text" name="profession" value="<%= profession %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Country:</label>
        <input class="form-control" type="text" name="country" value="<%= country %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Portrait (url):</label>
        <input class="form-control" type="text" name="portrait" value="<%= portrait %>">
      </div>
      <div class="mb-3">
        <label class="form-label">Biography:</label>
        <textarea class="form-control" name="biography" rows="3"><%= biography %></textarea>
      </div>
      <button class="btn btn-primary">Edit Author</button>
    </form>

    <% if (typeof message != "undefined"){ %>
  		 <h3 class="mt-3 text-success"><%=message%></h3>
    <% } %>

      </div>
    </div>
  </div>
</div>

<%- include("partials/footer.ejs") %>
</body>
</html>
