<%- include("partials/header.ejs") %>

<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
      <div class="card shadow-sm p-4">

<h1 class="mb-4">Adding a new Author</h1>


    <form method="POST" action="/author/new">
      <div class="mb-3">
        <label class="form-label">First Name:</label>
        <input class="form-control" type="text" name="fName">
      </div>
      <div class="mb-3">
        <label class="form-label">Last Name:</label>
        <input class="form-control" type="text" name="lName">
      </div>
      <div class="mb-3 container row">
        <div class="col">
          <label class="form-label">Date of Birth:</label>
          <input class="form-control" type="date" name="birthDate">
        </div>
        <div class="col">
          <label class="form-label">Date of Death:</label>
          <input class="form-control" type="date" name="deathDate">
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label d-block">Sex:</label>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="radio" name="sex" value="M"><label class="form-check-label">Male</label>
        </div>
        <div class="form-check form-check-inline">
          <input class="form-check-input" type="radio" name="sex" value="F"><label class="form-check-label">Female</label>
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Profession:</label>
        <input class="form-control" type="text" name="profession">
      </div>
      <div class="mb-3">
        <label class="form-label">Country:</label>
        <input class="form-control" type="text" name="country">
      </div>
      <div class="mb-3">
        <label class="form-label">Portrait (url):</label>
        <input class="form-control" type="text" name="portrait">
      </div>
      <div class="mb-3">
        <label class="form-label">Biography:</label>
        <textarea class="form-control" name="biography" rows="3"></textarea>
      </div>
      <button class="btn btn-primary">Add Author</button>
    </form>

    <% if (typeof message != "undefined"){ %>
  		 <h3 class="mt-3 text-success"><%=message%></h3>
    <% } %>

      </div>
    </div>
  </div>
</div>

<%- include("partials/footer.ejs") %>
</body>
</html>
